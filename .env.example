# Copie para .env e preencha. O .env NUNCA deve ser versionado.
# Nenhum destes valores é segredo — segredos não existem neste projeto (Managed Identity / OIDC).

# --- Tenant / Azure ---
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=brazilsouth
RESOURCE_PREFIX=m365up
# Client ID do App Registration do portal (gravado por scripts/New-EntraApplication.ps1)
ENTRA_APP_CLIENT_ID=
# Fluxo de login do App Service: idtoken (padrão, GA) | fic (Managed Identity como credencial — preview)
ENTRA_AUTH_FLOW=idtoken

# --- Microsoft 365 ---
M365_DEFAULT_DOMAIN=
M365_DEFAULT_USAGE_LOCATION=BR
TIMEZONE=America/Sao_Paulo

# --- Ciclo de vida ---
LIFECYCLE_ENGINE=native          # native | entra_lcw
LICENSE_MODE=group               # group | direct
LICENSE_LEAD_DAYS=1
TAP_LIFETIME_MINUTES=480
TAP_ONE_TIME_USE=true
OFFBOARDING_LICENSE_REMOVAL_DAYS=30

# --- Solicitações ---
# Campos: {nome} {inicial_nome} {primeiro_sobrenome} {ultimo_sobrenome} {sobrenomes}
UPN_PATTERN={nome}.{ultimo_sobrenome}
UPN_PARTICLES=da,das,de,del,der,di,do,dos,du,e,la,le,van,von,y
HIRE_DATE_PAST_DAYS=30
HIRE_DATE_FUTURE_DAYS=365

# --- Dados / LGPD ---
AUDIT_RETENTION_DAYS=1825

# --- Execução ---
# DRY_RUN=true: nada é alterado no Microsoft 365. Só mude para false após testar tudo.
# Máximo de contas criadas por dia (proteção contra erros em massa)
PROVISIONING_DAILY_LIMIT=20
ENVIRONMENT=lab                  # lab | production
DRY_RUN=true
STORAGE_BACKEND=sqlite           # sqlite (local) | azure_table (Azure)
ENABLE_API_DOCS=false

# --- Microsoft Graph ---
# msgraph: real (no Azure usa a Managed Identity; localmente usa o "az login")
# fake: dados simulados da Contoso, sem rede (padrão para desenvolvimento)
GRAPH_BACKEND=fake
GRAPH_CACHE_SECONDS=300
# Grupos que nunca podem ser usados em perfis (no Azure, preenchido automaticamente)
PROTECTED_GROUP_IDS=

# --- Autenticação ---
# easyauth: login pelo App Service (no Azure) · dev: usuário simulado (somente local)
AUTH_MODE=dev
DEV_USER_NAME=Usuário de Desenvolvimento
# Papéis simulados no modo dev (separados por vírgula):
# Provisionamento.Solicitante, Provisionamento.Aprovador, Provisionamento.Administrador
DEV_USER_ROLES=Provisionamento.Administrador
